OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: force the deterministic local agent for demos/tests, even when an
# OpenAI key exists. This is useful for a public resume demo with no API spend.
# INTERVIEWOS_AGENT_SOURCE=local

# Enable anonymous sign-ins in Supabase Auth for the no-login demo flow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: disable Supabase during browser tests or local-only UI work.
# NEXT_PUBLIC_INTERVIEWOS_DISABLE_SUPABASE=true
