{
  "name": "interviewos-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "evals": "tsc --noEmit false --outDir /private/tmp/interviewos-evals --module commonjs --target ES2020 --skipLibCheck --esModuleInterop scripts/run-evals.ts src/lib/interview/agent.ts src/lib/interview/types.ts src/lib/utils.ts && NODE_PATH=$PWD/node_modules node /private/tmp/interviewos-evals/scripts/run-evals.js",
    "check": "npm run lint && npm run build && npm run evals",
    "demo:check": "node scripts/check-demo-env.mjs",
    "deploy:check": "node scripts/check-demo-env.mjs --strict",
    "quality": "npm run check && npm run test:e2e",
    "test:e2e": "playwright test --config=playwright.config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "openai": "^6.39.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
